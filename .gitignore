MultiTalkBench/endpoints.json

# Local data — distributed via the HF dataset, not the GitHub repo
MultiTalkBench/datasets/
MultiTalkBench/prompts/
MultiTalkBench/prompts_train/

# Progress / cache files emitted by gen_prompts/*
MultiTalkBench/gen_prompts/*_progress.json
MultiTalkBench/batch_generate_progress.json

